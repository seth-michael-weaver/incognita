{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'static site: nothing to install'",
  "buildCommand": "echo 'static site: nothing to build'",
  "outputDirectory": "docs/walkthrough",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "nucleus-incognita-woad.vercel.app" }], "destination": "https://www.incognitanuclear.org/", "permanent": false },
    { "source": "/:path*", "has": [{ "type": "host", "value": "nucleus-incognita-woad.vercel.app" }], "destination": "https://www.incognitanuclear.org/:path*", "permanent": false },
    { "source": "/:dev(BRIEF\\.md|I18N_BRIEF\\.md|README\\.md|shot\\.sh|i18n_missing\\.sh|glossary_check\\.py|serve\\.py|make_scoreboard\\.py|vercel\\.json|\\.vercelignore)", "destination": "/", "permanent": false },
    { "source": "/:dev(BRIEF|I18N_BRIEF|README|_dev)", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(js|css)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    { "source": "/style.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ]
}
